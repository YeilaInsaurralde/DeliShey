# Copiar este archivo como ".env" y completar con los valores reales.
# El archivo ".env" NO se sube a GitHub. Este ejemplo sí, por eso no lleva datos reales.

# Puerto del servidor
PORT=3000

# Configuración MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=deli_shey


# Clave para firmar los tokens de sesión (JWT).
# Ge#nerar una aleatoria con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

# Dirección del frontend (para CORS y para el link del mail de recuperación de contraseña).
# Sin barra al final.
FRONTEND_URL=http://localhost:4200



# Correo transaccional - Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DeliShey

# Destinatario de los mensajes de contacto
EMAIL_TO=

# ImgBB - usar solo en backend, nunca en Angular
IMGBB_API_KEY=
# Para el comando manual admin:promote, proporcionar solo durante la ejecución
# ADMIN_EMAIL=
# ADMIN_CURRENT_PASSWORD=

# Solo para inicializar manualmente el primer administrador en una base nueva.
# No configurar en el frontend ni versionar contraseñas reales.
# Retirar las variables después de ejecutar npm run admin:bootstrap.
# ADMIN_BOOTSTRAP_NAME=Administrador
# ADMIN_BOOTSTRAP_EMAIL=admin@ejemplo.com
# ADMIN_BOOTSTRAP_PASSWORD=
