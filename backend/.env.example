# Copiar este archivo como ".env" y completar con los valores reales.
# El archivo ".env" NO se sube a GitHub. Este ejemplo sí, por eso no lleva datos reales.

# Puerto del servidor
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=deli_shey

# Clave para firmar los tokens de sesión (JWT).
# Generar una aleatoria con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

# Dirección del frontend (para CORS y para el link del mail de recuperación de contraseña).
# Sin barra al final.
FRONTEND_URL=http://localhost:4200

# Cuenta de Gmail que envía los mails (recuperación de contraseña y consultas de contacto).
# EMAIL_PASS es una "contraseña de aplicación" de Google, no la contraseña normal de la cuenta.
EMAIL_USER=tu_cuenta@gmail.com
EMAIL_PASS=contraseña_de_aplicacion_de_16_letras

# Casilla donde se reciben las consultas del formulario de contacto
EMAIL_TO=correo_donde_recibir_consultas@ejemplo.com